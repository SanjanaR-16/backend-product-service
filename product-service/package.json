{
  "name": "product-service",
  "version": "1.0.0",
  "bin": {
    "product-service": "bin/product-service.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:synth": "cdk synth",
    "build:lambda": "tsc -p tsconfig.lambda.json",
    "cdk:deploy": "npm run build:lambda && cdk deploy --require-approval never",
    "cdk:destroy": "cdk destroy --force"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "2.1118.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.248.0",
    "constructs": "^10.5.0"
  }
}
